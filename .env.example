MYSQL_DATABASE=edu
MYSQL_USER=edu
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
MYSQL_PORT=3306

# Required by the V0.2 stateless JWT API. Replace with a private value of at least 32 bytes.
JWT_SECRET=replace_with_a_private_secret_of_at_least_32_bytes
JWT_ISSUER=https://edu-java.local
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# Optional, one-time bootstrap for the first system administrator. Leave both blank to disable it.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NICKNAME=System Administrator

REDIS_PORT=6379

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_neo4j_me

MODEL_SERVICE_BASE_URL=http://localhost:8001
