# Copy this file to .env.release. Do not commit the copied file.
# Generate local non-production values with scripts/generate-local-release-env.ps1
# or scripts/generate-local-release-env.sh. The full-stack compose file rejects
# missing placeholders instead of silently selecting development credentials.

MYSQL_DATABASE=edu
MYSQL_USER=edu
MYSQL_PASSWORD=<required-private-value>
MYSQL_ROOT_PASSWORD=<required-private-value>
MYSQL_PORT=3306

# Required by the stateless JWT API. Use a private value of at least 32 bytes.
JWT_SECRET=<required-private-value-at-least-32-bytes>
JWT_ISSUER=https://edu-java.local
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# Optional one-time bootstrap for a non-demo environment. Leave both blank to disable it.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NICKNAME=System Administrator

# Redis is an optional cache in V0.7. A Redis outage is reported as DEGRADED,
# while MySQL and Neo4j failures make readiness fail.
REDIS_PORT=6379

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<required-private-value>

BACKEND_PORT=8080
FRONTEND_PORT=8081
VITE_API_BASE_URL=/api/v1
# Comma-separated browser origins; do not use * in release mode.
CORS_ALLOWED_ORIGINS=http://localhost:8081

APP_BUILD_VERSION=0.7.0-rc
APP_BUILD_TIME=local
APP_DEMO_SEED_ENABLED=true
